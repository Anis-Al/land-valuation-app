{
  "name": "land-valuation-app",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "db:start": "docker run --platform linux/amd64 --rm -p 5432:5432 --name pg -e POSTGRES_USER=db_user -e POSTGRES_PASSWORD=db_password -e POSTGRES_DB=db postgis/postgis:17-3.5-alpine",
    "db:generate": "dotenv -- drizzle-kit generate --name",
    "db:migrate": "dotenv -- drizzle-kit migrate",
    "db:seed": "dotenv -- tsx core/database/seed.ts",
    "processor:test": "dotenv -- tsx core/processor/test.ts",
    "build": "react-router build",
    "dev": "react-router dev --host",
    "start": "dotenv -- react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint --fix",
    "pretty": "prettier --write app core",
    "pretty-watch": "onchange \"app/**/*\" \"core/**/*\" -- prettier --write --ignore-unknown {{changed}}"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
